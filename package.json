{
  "name": "paperclip-litellm-adapter",
  "version": "0.1.0",
  "description": "LiteLLM gateway adapter for Paperclip. Auto-discovers models from your LiteLLM instance via /models and /model/info.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "paperclip",
    "litellm",
    "llm",
    "gateway",
    "adapter",
    "openai-compatible",
    "anthropic-compatible"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nihaopaul/paperclip-litellm-adapter.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
